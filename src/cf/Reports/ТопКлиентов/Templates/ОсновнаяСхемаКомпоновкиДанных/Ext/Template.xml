				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма заказов за период</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ ПЕРВЫЕ 10
		ПродажиОбороты.СкидочнаяКарта.Клиент КАК Клиент,
		ПродажиОбороты.СкидочнаяКарта КАК СкидочнаяКарта,
		СУММА(ПродажиОбороты.СуммаОборот) КАК СуммаЗаказов
	ИЗ
		РегистрНакопления.Продажи.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , Ресторан = &amp;Ресторан) КАК ПродажиОбороты
	ГДЕ
		ПродажиОбороты.СкидочнаяКарта &lt;&gt; ЗНАЧЕНИЕ(Справочник.СкидочныеКарты.ПустаяСсылка)

	СГРУППИРОВАТЬ ПО
		ПродажиОбороты.СкидочнаяКарта,
		ПродажиОбороты.СкидочнаяКарта.Клиент

	УПОРЯДОЧИТЬ ПО
		СуммаЗаказов УБЫВ</query>
	</dataSet>
	<totalField>
		<dataPath>СуммаЗаказов</dataPath>
