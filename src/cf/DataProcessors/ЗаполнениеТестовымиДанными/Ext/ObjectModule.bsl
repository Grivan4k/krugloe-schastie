	ДобавитьРецептуру("Салат ""Мимоза""", 25, СоставМимозы);

КонецПроцедуры

Функция Ингредиент(Ссылка, Количество, ЕдиницаИзмерения)
	Возврат Новый Структура("Ингредиент, Количество, ЕдиницаИзмерения", Ссылка, Количество, ЕдиницаИзмерения);
КонецФункции

Процедура ДобавитьРецептуру(ИмяБлюда, ВремяПриготовления, Состав)

	Блюдо = Блюда.Получить(ИмяБлюда);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Рецептуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Рецептуры КАК Рецептуры
	|ГДЕ
	|	Рецептуры.Владелец = &Блюдо";
	Запрос.УстановитьПараметр("Блюдо", Блюдо);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	Объект = Справочники.Рецептуры.СоздатьЭлемент();
	Объект.Владелец = Блюдо;
	Объект.ВремяПриготовления = ВремяПриготовления;
	Для Каждого Строка Из Состав Цикл
		ЗаполнитьЗначенияСвойств(Объект.Ингредиенты.Добавить(), Строка);
	КонецЦикла;
	Объект.Записать();
	Журнал.Добавить("Создана рецептура: " + ИмяБлюда);

КонецПроцедуры

Процедура ЗаполнитьКлиентовИКарты()

	Типы = Перечисления.ТипыСкидочныхКарт;
	Выдал = Сотрудники.Получить("Каменская");

	Чалова = ДобавитьКлиента("Чалова", "Ирина", "Хасановна", "+7(923)500 0001");
	Барабаш = ДобавитьКлиента("Барабаш", "Марина", "Борисовна", "+7(923)500 0002");
	Евстафьева = ДобавитьКлиента("Евстафьева", "Наталья", "Ивановна", "+7(923)500 0003");
	ДобавитьКлиента("", "Олег", "", "+7(923)500 0004"); // фамилия не обязательна

	// У одного клиента может быть несколько карт: у Чаловой их две.
	ДобавитьКарты(Чалова, 2, Типы.Скидка5, Выдал);
	ДобавитьКарты(Барабаш, 1, Типы.КаждыйДесятыйПлюс, Выдал);
	ДобавитьКарты(Евстафьева, 1, Типы.КаждыйДесятыйМинус, Выдал);

КонецПроцедуры

Функция ДобавитьКлиента(Фамилия, Имя, Отчество, Телефон)

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрШаблон("%1|%2|%3", Фамилия, Имя, Отчество), "|", Ложь) Цикл
		Части.Добавить(Часть);
	КонецЦикла;
	Наименование = СтрСоединить(Части, " ");

	Ссылка = Справочники.Клиенты.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Клиенты.СоздатьЭлемент();
		Объект.Фамилия = Фамилия;
		Объект.Имя = Имя;
		Объект.Отчество = Отчество;
		Объект.Наименование = Наименование;
		Объект.Телефон = Телефон;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
		Журнал.Добавить("Создан клиент: " + Наименование);
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

Процедура ДобавитьКарты(Клиент, Количество, ТипКарты, Выдал)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СкидочныеКарты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкидочныеКарты КАК СкидочныеКарты
	|ГДЕ
	|	СкидочныеКарты.Клиент = &Клиент
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкидочныеКарты.Код";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Существующие = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Для Каждого Карта Из Существующие Цикл
		Карты.Добавить(Карта);
	КонецЦикла;

	Для Номер = Существующие.Количество() + 1 По Количество Цикл
		Объект = Справочники.СкидочныеКарты.СоздатьЭлемент();
		Объект.Клиент = Клиент;
		Объект.ДатаВыдачи = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -4));
		Объект.Выдал = Выдал;
		Объект.ТипКарты = ТипКарты;
		Объект.Записать();
		Карты.Добавить(Объект.Ссылка);
		Журнал.Добавить(СтрШаблон("Выдана карта %1: %2", Объект.Код, Клиент));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Документы

Функция ЗаказовНет()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегистрацияЗаказа.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РегистрацияЗаказа КАК РегистрацияЗаказа";
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

Процедура СоздатьПоступления()

	НачалоПрошлогоМесяца = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));

	// Яиц и томатов привезено меньше обязательного остатка - в отчете 31.а они будут красными.
	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Продукт, Количество, Цена", Продукты.Получить("Яйцо"), 2, 60));
	Строки.Добавить(Новый Структура("Продукт, Количество, Цена", Продукты.Получить("Молоко"), 30, 80));
	Строки.Добавить(Новый Структура("Продукт, Количество, Цена", Продукты.Получить("Соль"), 5, 25));
	Строки.Добавить(Новый Структура("Продукт, Количество, Цена", Продукты.Получить("Мука"), 25, 45));
	СоздатьПоступление(НачалоПрошлогоМесяца + 9 * 3600, "Ешь до дыр", "ООО ""Мир""", Строки);

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Продукт, Количество, Цена", Продукты.Получить("Сыр моцарелла"), 12, 650));
	Строки.Добавить(Новый Структура("Продукт, Количество, Цена", Продукты.Получить("Томаты"), 4, 180));
	Строки.Добавить(Новый Структура("Продукт, Количество, Цена", Продукты.Получить("Говядина"), 15, 700));
	СоздатьПоступление(НачалоПрошлогоМесяца + 86400 + 10 * 3600, "Ешь до дыр", "ООО ""Свет""", Строки);

КонецПроцедуры

Процедура СоздатьПоступление(ДатаДокумента, Ресторан, Поставщик, Строки)

	Документ = Документы.ПоступлениеПродуктов.СоздатьДокумент();
	Документ.Дата = ДатаДокумента;
	Документ.Ресторан = Рестораны.Получить(Ресторан);
	Документ.Поставщик = Поставщики.Получить(Поставщик);
	Для Каждого Строка Из Строки Цикл
		ЗаполнитьЗначенияСвойств(Документ.Продукты.Добавить(), Строка);
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Журнал.Добавить(СтрШаблон("Проведено поступление от %1 на %2 руб.", Поставщик, Документ.СуммаДокумента));

КонецПроцедуры

// Закрытые заказы за два прошлых месяца и текущий. Один "стандартный" заказ стоит 10 000 руб.,
// число заказов подобрано так, чтобы у части официантов сумма за месяц была больше 200 000 руб.
// (в отчете 17.а такие строки выделяются жирным).
Процедура СоздатьЗаказы()

	План = Новый Массив;
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", -2, "Каменская", "Ешь до дыр", 33));
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", -2, "Иванюхина", "Ешь до дыр", 18));
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", -2, "Швецова", "Пицца на углу", 23));
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", -1, "Каменская", "Ешь до дыр", 18));
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", -1, "Иванюхина", "Ешь до дыр", 21));
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", -1, "Швецова", "Пицца на углу", 20));
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", 0, "Каменская", "Ешь до дыр", 3));
	План.Добавить(Новый Структура("Сдвиг, Официант, Ресторан, Заказов", 0, "Швецова", "Пицца на углу", 2));

	ВсегоЗаказов = 0;
	Для Каждого Строка Из План Цикл
		НачалоПериода = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), Строка.Сдвиг));
		Для Номер = 1 По Строка.Заказов Цикл
			ВсегоЗаказов = ВсегоЗаказов + 1;
			// Заказы прошлых месяцев раскладываются по дням, заказы текущего месяца - на несколько часов назад.
			Если Строка.Сдвиг = 0 Тогда
				ДатаОткрытия = Макс(НачалоПериода, ТекущаяДатаСеанса() - Номер * 1800 - 3600);
			Иначе
				ДатаОткрытия = НачалоПериода + ((Номер - 1) % 27) * 86400 + (11 + Номер % 9) * 3600;
			КонецЕсли;
			СоздатьЗаказ(ДатаОткрытия, Строка.Ресторан, Строка.Официант, Номер % 10 + 1, КартаЗаказа(ВсегоЗаказов),
				СоставСтандартногоЗаказа(ВсегоЗаказов), Истина);
		КонецЦикла;
	КонецЦикла;

	// Два открытых заказа: столы 1 и 2 заняты (задача 06).
	СоставОткрытого = Новый Массив;
	СоставОткрытого.Добавить(Новый Структура("Блюдо, Количество", Блюда.Получить("Борщ"), 2));
	СоставОткрытого.Добавить(Новый Структура("Блюдо, Количество", Блюда.Получить("Морс клюквенный"), 2));
	СоздатьЗаказ(ТекущаяДатаСеанса(), "Ешь до дыр", "Каменская", 1, Неопределено, СоставОткрытого, Ложь);
	СоздатьЗаказ(ТекущаяДатаСеанса(), "Ешь до дыр", "Иванюхина", 2, Неопределено, СоставОткрытого, Ложь);

	Журнал.Добавить(СтрШаблон("Создано закрытых заказов: %1, открытых: 2.", ВсегоЗаказов));

КонецПроцедуры

// Каждый 3-й заказ - по картам Чаловой, каждый 5-й - Барабаш, каждый 7-й - Евстафьевой.
Функция КартаЗаказа(НомерЗаказа)

	Если Карты.Количество() < 4 Тогда
		Возврат Неопределено;
	ИначеЕсли НомерЗаказа % 3 = 0 Тогда
		Возврат Карты[НомерЗаказа % 2]; // две карты Чаловой по очереди
	ИначеЕсли НомерЗаказа % 5 = 0 Тогда
		Возврат Карты[2];
	ИначеЕсли НомерЗаказа % 7 = 0 Тогда
		Возврат Карты[3];
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// 10 000 руб.: пицца 5 x 980 + стейк 4 x 1 200 + колбаски 1 x 300.
// В каждом 4-м заказе колбаски заменены напитками той же стоимости (120 + 2 x 90 = 300 руб.), чтобы в "Топ-10 блюд" было больше позиций.
Функция СоставСтандартногоЗаказа(НомерЗаказа)

	Состав = Новый Массив;
	Состав.Добавить(Новый Структура("Блюдо, Количество", Блюда.Получить("Пицца ""Маргарита"""), 5));
	Состав.Добавить(Новый Структура("Блюдо, Количество", Блюда.Получить("Стейк из говядины"), 4));
	Если НомерЗаказа % 4 = 0 Тогда
		Состав.Добавить(Новый Структура("Блюдо, Количество", Блюда.Получить("Кола 0,5 л"), 1));
		Состав.Добавить(Новый Структура("Блюдо, Количество", Блюда.Получить("Морс клюквенный"), 2));
	Иначе
		Состав.Добавить(Новый Структура("Блюдо, Количество", Блюда.Получить("Колбаски ""Охотничьи"""), 1));
	КонецЕсли;
	Возврат Состав;

КонецФункции

Процедура СоздатьЗаказ(ДатаОткрытия, Ресторан, Официант, Стол, Карта, Состав, Закрыть)

	Документ = Документы.РегистрацияЗаказа.СоздатьДокумент();
	Документ.Дата = ДатаОткрытия;
	Документ.Ресторан = Рестораны.Получить(Ресторан);
	Документ.Официант = Сотрудники.Получить(Официант);
	Документ.Стол = Стол;
	Если ЗначениеЗаполнено(Карта) Тогда
		Документ.СкидочнаяКарта = Карта;
		Документ.Клиент = Карта.Клиент;
	Иначе
		Документ.Клиент = Справочники.Клиенты.РозничныйПокупатель;
	КонецЕсли;

	Для Каждого Строка Из Состав Цикл
		Если Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Документ.Блюда.Добавить();
		НоваяСтрока.Блюдо = Строка.Блюдо;
		НоваяСтрока.Количество = Строка.Количество;
		НоваяСтрока.Цена = Строка.Блюдо.Цена;
	КонецЦикла;

	// Тестовые заказы получают даты из прошлого, поэтому автоматическая простановка дат отключается.
	Документ.ДатаОткрытия = ДатаОткрытия;
	Если Закрыть Тогда
		Документ.Закрыт = Истина;
		Документ.ДатаЗакрытия = ДатаОткрытия + 1800;
	КонецЕсли;
	Документ.ДополнительныеСвойства.Вставить("ДатыИзТестовыхДанных", Истина);
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

