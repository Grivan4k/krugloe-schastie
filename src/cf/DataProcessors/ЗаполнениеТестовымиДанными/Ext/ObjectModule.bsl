Процедура ДобавитьСотрудника(Ключ, Фамилия, Имя, Отчество, Должность, Ресторан, ДатаРождения, Телефон)

	Наименование = СтрШаблон("%1 %2 %3", Фамилия, Имя, Отчество);
	Ссылка = Справочники.Сотрудники.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Сотрудники.СоздатьЭлемент();
		Объект.Фамилия = Фамилия;
		Объект.Имя = Имя;
		Объект.Отчество = Отчество;
		Объект.Наименование = Наименование;
		Объект.Должность = Должность;
		Объект.Ресторан = Рестораны.Получить(Ресторан);
		Объект.ДатаРождения = ДатаРождения;
		Объект.Телефон = Телефон;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
		Журнал.Добавить("Создан сотрудник: " + Наименование);
	КонецЕсли;
	Сотрудники.Вставить(Ключ, Ссылка);

