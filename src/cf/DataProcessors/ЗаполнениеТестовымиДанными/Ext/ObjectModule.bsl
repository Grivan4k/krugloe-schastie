Процедура ЗаполнитьРецептуры()

	// Ингредиентом может быть продукт или готовое блюдо (задача 27.а).
	СоставОмлета = Новый Массив;
	СоставОмлета.Добавить(Ингредиент(Продукты.Получить("Яйцо"), 1, "шт"));
	СоставОмлета.Добавить(Ингредиент(Продукты.Получить("Соль"), 2, "г"));
