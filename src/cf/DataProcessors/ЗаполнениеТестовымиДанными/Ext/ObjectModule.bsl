	Если ЗначениеЗаполнено(РесторанСсылка.Руководитель) Тогда
		Возврат;
	КонецЕсли;
	Объект = РесторанСсылка.ПолучитьОбъект();
	Объект.Руководитель = Сотрудники.Получить(Сотрудник);
	Объект.Записать();

