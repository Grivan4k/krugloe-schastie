Процедура ДобавитьРесторан(Наименование, Родитель, Адрес, Телефон, ДатаОткрытия)

	Ссылка = Справочники.Рестораны.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Рестораны.СоздатьЭлемент();
		Объект.Наименование = Наименование;
		Объект.Родитель = Родитель;
		Объект.Адрес = Адрес;
		Объект.Телефон = Телефон;
		Объект.ДатаОткрытия = ДатаОткрытия;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
		Журнал.Добавить("Создан: " + Наименование);
	КонецЕсли;
	Рестораны.Вставить(Наименование, Ссылка);

КонецПроцедуры

