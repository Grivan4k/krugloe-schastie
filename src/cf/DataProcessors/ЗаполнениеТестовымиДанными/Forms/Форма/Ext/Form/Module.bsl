#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Заполнить базу тестовыми данными (справочники, поступления и заказы за 3 месяца)?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ЗаполнитьНаСервере();
	Для Каждого Строка Из СтрРазделить(Результат, Символы.ПС, Ложь) Цикл
		Сообщить(Строка);
	КонецЦикла;
	ПоказатьОповещениеПользователя("Тестовые данные загружены");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ЗаполнитьДанные();
	
КонецФункции

#КонецОбласти
