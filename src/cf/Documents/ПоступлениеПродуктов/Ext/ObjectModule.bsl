#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Поступление продуктов от поставщика (задача 28): увеличивает остатки продуктов
// ресторана и фиксирует долг перед поставщиком на общую сумму поставки.

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПродукта Из Продукты Цикл
		СтрокаПродукта.Сумма = СтрокаПродукта.Количество * СтрокаПродукта.Цена;
	КонецЦикла;
	СуммаДокумента = Продукты.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ОстаткиПродуктов.Записывать = Истина;
	Движения.РасчетыСПоставщиками.Записывать = Истина;

	ТаблицаПродуктов = Продукты.Выгрузить(, "Продукт, Количество");
	ТаблицаПродуктов.Свернуть("Продукт", "Количество");

	Для Каждого СтрокаПродукта Из ТаблицаПродуктов Цикл
		Движение = Движения.ОстаткиПродуктов.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Ресторан = Ресторан;
		Движение.Продукт = СтрокаПродукта.Продукт;
		Движение.Количество = СтрокаПродукта.Количество;
	КонецЦикла;

	Движение = Движения.РасчетыСПоставщиками.ДобавитьПриход();
	Движение.Период = Дата;
	Движение.Ресторан = Ресторан;
	Движение.Поставщик = Поставщик;
	Движение.Сумма = СуммаДокумента;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение "Недопустимый вызов объекта на клиенте.";
#КонецЕсли
