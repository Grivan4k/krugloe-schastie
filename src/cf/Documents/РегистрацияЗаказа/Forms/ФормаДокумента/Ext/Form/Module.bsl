#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	// Любая запись открытого заказа - это проведение: стол сразу считается занятым.
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УстановитьДоступность();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СкидочнаяКартаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.СкидочнаяКарта) Тогда
		Объект.Клиент = КлиентКарты(Объект.СкидочнаяКарта);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыБлюда

&НаКлиенте
Процедура БлюдаБлюдоПриИзменении(Элемент)

	// Цена подставляется из карточки блюда (задача 10).
	ТекущаяСтрока = Элементы.Блюда.ТекущиеДанные;
	ТекущаяСтрока.Цена = ЦенаБлюда(ТекущаяСтрока.Блюдо);
	Если ТекущаяСтрока.Количество = 0 Тогда
		ТекущаяСтрока.Количество = 1;
	КонецЕсли;
	ПересчитатьСтроку(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура БлюдаКоличествоПриИзменении(Элемент)
	ПересчитатьСтроку(Элементы.Блюда.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура БлюдаЦенаПриИзменении(Элемент)
	ПересчитатьСтроку(Элементы.Блюда.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура БлюдаПослеУдаления(Элемент)
	ПересчитатьИтог();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьЗаказ(Команда)

	Если Объект.Закрыт Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ЗакрытьЗаказЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Гости рассчитались? После закрытия заказ нельзя будет изменить.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьЗаказЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Объект.Закрыт = Истина;
	Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда
		Объект.Закрыт = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПересчитатьСтроку(СтрокаБлюда)

	Если СтрокаБлюда = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаБлюда.Сумма = СтрокаБлюда.Количество * СтрокаБлюда.Цена;
	ПересчитатьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтог()
	Объект.СуммаЗаказа = Объект.Блюда.Итог("Сумма");
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность()

	ТолькоПросмотр = Объект.Закрыт;
	Элементы.ФормаЗакрытьЗаказ.Доступность = Не Объект.Закрыт;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаБлюда(Блюдо)

	Если Не ЗначениеЗаполнено(Блюдо) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Блюдо.Цена;

КонецФункции

&НаСервереБезКонтекста
Функция КлиентКарты(СкидочнаяКарта)
	Возврат СкидочнаяКарта.Клиент;
КонецФункции

#КонецОбласти
