#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	// Клиент, который не представился, - "Розничный покупатель".
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Клиент = Справочники.Клиенты.РозничныйПокупатель;
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Закрыт = Ложь;
	ДатаОткрытия = Дата(1, 1, 1);
	ДатаЗакрытия = Дата(1, 1, 1);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(Официант) И Официант.Должность <> Перечисления.Должности.Официант Тогда
		СообщитьПользователю("В заказе можно указать только сотрудника с должностью ""Официант"".", "Официант", Отказ);
	КонецЕсли;

	Если ЗначениеЗаполнено(СкидочнаяКарта) И СкидочнаяКарта.Клиент <> Клиент Тогда
		СообщитьПользователю("Скидочная карта выдана другому клиенту.", "СкидочнаяКарта", Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Закрытый заказ нельзя изменить, перепровести, отменить проведение или пометить на удаление.
	Если ЗаказЗакрытВБазе() Тогда
		СообщитьПользователю("Заказ закрыт (гости рассчитались), изменять его нельзя.", "Закрыт", Отказ);
		Возврат;
	КонецЕсли;

	// Даты проставляет только система. Исключение - обработка заполнения тестовыми данными,
	// которая создает заказы задним числом и сама заполняет даты.
	Если Не ДополнительныеСвойства.Свойство("ДатыИзТестовыхДанных") Тогда
		Если ЭтоНовый() Или Не ЗначениеЗаполнено(ДатаОткрытия) Тогда
			ДатаОткрытия = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Закрыт Тогда
			ДатаЗакрытия = ТекущаяДатаСеанса();
		Иначе
			ДатаЗакрытия = Дата(1, 1, 1);
		КонецЕсли;
	КонецЕсли;
	
	// Сумма строки и итог заказа пересчитываются на сервере (задача 10).
	Для Каждого СтрокаБлюда Из Блюда Цикл
		СтрокаБлюда.Сумма = СтрокаБлюда.Количество * СтрокаБлюда.Цена;
	КонецЦикла;
	СуммаЗаказа = Блюда.Итог("Сумма");

КонецПроцедуры

Процедура ПередУдалением(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Закрыт Тогда
		СообщитьПользователю("Закрытый заказ удалить нельзя.", "Закрыт", Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// На один стол ресторана не может быть открыто несколько заказов (проверяется для открытого заказа).
	ЗанятыйЗаказ = ?(Закрыт, Неопределено, ДругойОткрытыйЗаказНаСтоле());
	Если ЗанятыйЗаказ <> Неопределено Тогда
		СообщитьПользователю(СтрШаблон("На стол %1 уже открыт заказ: %2.", Стол, ЗанятыйЗаказ), "Стол", Отказ);
		Возврат;
	КонецЕсли;

	Движения.Продажи.Записывать = Истина;

	// Продажи фиксируются только по закрытому заказу (гости рассчитались).
	Если Не Закрыт Тогда
		Возврат;
	КонецЕсли;

	ТаблицаБлюд = Блюда.Выгрузить(, "Блюдо, Количество, Сумма");
	ТаблицаБлюд.Свернуть("Блюдо", "Количество, Сумма");

	Для Каждого СтрокаБлюда Из ТаблицаБлюд Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = ДатаЗакрытия;
		Движение.Ресторан = Ресторан;
		Движение.Официант = Официант;
		Движение.Клиент = Клиент;
		Движение.СкидочнаяКарта = СкидочнаяКарта;
		Движение.Блюдо = СтрокаБлюда.Блюдо;
		Движение.Количество = СтрокаБлюда.Количество;
		Движение.Сумма = СтрокаБлюда.Сумма;
		Движение.КоличествоЗаказов = 1;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаказЗакрытВБазе()

	Если ЭтоНовый() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Ссылка.Закрыт;

КонецФункции

// Возвращает другой открытый (проведенный, не закрытый) заказ на этом столе или Неопределено.
Функция ДругойОткрытыйЗаказНаСтоле()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегистрацияЗаказа.Ссылка КАК Заказ
	|ИЗ
	|	Документ.РегистрацияЗаказа КАК РегистрацияЗаказа
	|ГДЕ
	|	РегистрацияЗаказа.Проведен
	|	И НЕ РегистрацияЗаказа.Закрыт
	|	И РегистрацияЗаказа.Ресторан = &Ресторан
	|	И РегистрацияЗаказа.Стол = &Стол
	|	И РегистрацияЗаказа.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Ресторан", Ресторан);
	Запрос.УстановитьПараметр("Стол", Стол);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура СообщитьПользователю(Текст, ИмяПоля, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение "Недопустимый вызов объекта на клиенте.";
#КонецЕсли
