#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Наименование не вводится вручную, оно собирается из ФИО.
	ЗаполнитьНаименование();

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьНаименование();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьНаименование()

	ЧастиФИО = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрШаблон("%1|%2|%3", Фамилия, Имя, Отчество), "|") Цикл
		Если Не ПустаяСтрока(Часть) Тогда
			ЧастиФИО.Добавить(СокрЛП(Часть));
		КонецЕсли;
	КонецЦикла;

	Если ЧастиФИО.Количество() > 0 Тогда
		Наименование = СтрСоединить(ЧастиФИО, " ");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение "Недопустимый вызов объекта на клиенте.";
#КонецЕсли
