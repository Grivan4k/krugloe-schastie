#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборРазделМенюПриИзменении(Элемент)
	УстановитьОтборПоРазделу();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Печатная форма "Меню" (задача 08.а).
&НаКлиенте
Процедура ПечатьМеню(Команда)

	ТабличныйДокумент = ПечатьМенюНаСервере();
	ТабличныйДокумент.Показать("Меню");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отбирает в динамическом списке блюда выбранного раздела меню (задача 04).
// Пустое значение раздела снимает отбор.
//
&НаКлиенте
Процедура УстановитьОтборПоРазделу()

	ПолеРаздела = Новый ПолеКомпоновкиДанных("РазделМеню");

	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ЭлементОтбора.ЛевоеЗначение = ПолеРаздела Тогда
			Список.Отбор.Элементы.Удалить(ЭлементОтбора);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ОтборРазделМеню) Тогда
		Возврат;
	КонецЕсли;

	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = ПолеРаздела;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ОтборРазделМеню;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПечатьМенюНаСервере()
	Возврат Справочники.Блюда.ПечатьМеню();
КонецФункции

#КонецОбласти
