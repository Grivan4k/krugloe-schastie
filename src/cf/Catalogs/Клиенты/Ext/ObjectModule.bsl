#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Фамилия не обязательна. Имя обязательно для всех, кроме "Розничного покупателя".
	Если Не Предопределенный И ПустаяСтрока(Имя) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите имя клиента.";
		Сообщение.Поле = "Имя";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	ЗаполнитьНаименование();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаименование();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьНаименование()
	
	ЧастиФИО = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрШаблон("%1|%2|%3", Фамилия, Имя, Отчество), "|") Цикл
		Если Не ПустаяСтрока(Часть) Тогда
			ЧастиФИО.Добавить(СокрЛП(Часть));
		КонецЕсли;
	КонецЦикла;
	
	Если ЧастиФИО.Количество() > 0 Тогда
		Наименование = СтрСоединить(ЧастиФИО, " ");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение "Недопустимый вызов объекта на клиенте.";
#КонецЕсли
