#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Рецептура подчинена блюду (владелец - справочник "Блюда") и открывается
// из карточки блюда. Хранится только последний вариант рецепта (задача 27.а).

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(Владелец) И ЕстьДругаяРецептура() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("У блюда ""%1"" уже есть рецептура. Измените ее, а не создавайте новую.", Владелец);
		Сообщение.Поле = "Владелец";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Наименование = Лев(СтрШаблон("Рецептура: %1", Владелец), 150);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьДругаяРецептура()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Рецептуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Рецептуры КАК Рецептуры
	|ГДЕ
	|	Рецептуры.Владелец = &Владелец
	|	И Рецептуры.Ссылка <> &Ссылка
	|	И НЕ Рецептуры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение "Недопустимый вызов объекта на клиенте.";
#КонецЕсли
