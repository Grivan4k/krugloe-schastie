#Область ОбработчикиСобытий

Процедура ПриНачалеРаботыСистемы()
	
	// Первый запуск пустой базы: создать пользователей с ролями и перезапустить систему.
	Если СеансВызовСервера.СоздатьПользователейПоУмолчанию() Тогда
		Оповещение = Новый ОписаниеОповещения("ПерезапуститьПослеСозданияПользователей", ЭтотОбъект);
		ПоказатьПредупреждение(Оповещение,
			"Созданы пользователи: Администратор, Иванова Мира Сергеевна (менеджер ресторана), "
			+ "Петров Олег Иванович (повар), Каменская Дарья Викторовна, Иванюхина Дарья Игоревна, "
			+ "Швецова Валерия Евгеньевна (обслуживающий персонал). Пароль у всех: 123. "
			+ "Система будет перезапущена, при входе выберите пользователя "
			+ "(администратора введите вручную: он скрыт из списка).");
		Возврат;
	КонецЕсли;
	
	Данные = СеансВызовСервера.ДанныеСеанса();
	УстановитьЗаголовокОкна(Данные);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит в заголовок окна дату и время начала работы, имя пользователя
// и название конфигурации (задача 02).
//
// Параметры:
//  Данные - Структура - результат СеансВызовСервера.ДанныеСеанса().
//
Процедура УстановитьЗаголовокОкна(Данные)
	
	Заголовок = СтрШаблон("%1 | %2 | %3",
		Формат(Данные.НачалоРаботы, "ДФ='dd.MM.yyyy HH:mm:ss'"),
		Данные.Пользователь,
		Данные.Конфигурация);
	УстановитьЗаголовокКлиентскогоПриложения(Заголовок);
	
КонецПроцедуры

// Обработчик оповещения после предупреждения о созданных пользователях.
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - не используется.
//
Процедура ПерезапуститьПослеСозданияПользователей(ДополнительныеПараметры) Экспорт
	ЗавершитьРаботуСистемы(Ложь, Истина);
КонецПроцедуры

#КонецОбласти
