#Область ПрограммныйИнтерфейс

// Возвращает данные текущего сеанса для заголовка окна.
//
// Возвращаемое значение:
//  Структура:
//   * Пользователь - Строка - полное имя пользователя информационной базы.
//   * НачалоРаботы - Дата - дата и время начала работы.
//   * Конфигурация - Строка - синоним конфигурации.
//
Функция ДанныеСеанса() Экспорт
	
	Данные = Новый Структура;
	Данные.Вставить("Пользователь", ПолноеИмяПользователя());
	Данные.Вставить("НачалоРаботы", ТекущаяДатаСеанса());
	Данные.Вставить("Конфигурация", Метаданные.Синоним);
	Возврат Данные;
	
КонецФункции

// Создает пользователей информационной базы с ролями (задача 02), если в базе еще нет ни одного
// пользователя. Вызывается при первом запуске пустой базы.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователи были созданы.
//
Функция СоздатьПользователейПоУмолчанию() Экспорт
	
	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Пароль = "123";
	// Администратор создается первым и не показывается в списке выбора при входе.
	СоздатьПользователя("Администратор", "Администратор", "Администратор", Пароль, Ложь);
	СоздатьПользователя("Иванова Мира Сергеевна", "Иванова Мира Сергеевна", "МенеджерРесторана", Пароль, Истина);
	СоздатьПользователя("Петров Олег Иванович", "Петров Олег Иванович", "Повар", Пароль, Истина);
	СоздатьПользователя("Каменская Дарья Викторовна", "Каменская Дарья Викторовна", "ОбслуживающийПерсонал", Пароль, Истина);
	СоздатьПользователя("Иванюхина Дарья Игоревна", "Иванюхина Дарья Игоревна", "ОбслуживающийПерсонал", Пароль, Истина);
	СоздатьПользователя("Швецова Валерия Евгеньевна", "Швецова Валерия Евгеньевна", "ОбслуживающийПерсонал", Пароль, Истина);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьПользователя(Имя, ПолноеИмя, ИмяРоли, Пароль, ПоказыватьВСписке)
	
	ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	ПользовательИБ.Имя = Имя;
	ПользовательИБ.ПолноеИмя = ПолноеИмя;
	ПользовательИБ.АутентификацияСтандартная = Истина;
	ПользовательИБ.Пароль = Пароль;
	ПользовательИБ.ПоказыватьВСпискеВыбора = ПоказыватьВСписке;
	ПользовательИБ.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
	
	// Администратору не нужны предупреждения при открытии внешних обработок (Vanessa Automation).
	Если ИмяРоли = "Администратор" Тогда
		ПользовательИБ.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	КонецЕсли;
	
	ПользовательИБ.Записать();
	
КонецПроцедуры

#КонецОбласти
