ыть заказ», подтвердить расчет" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="120" y="1130" width="240" height="40" as="geometry"/></mxCell><mxCell id="p2-c21" value="Проставить дату и время закрытия" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="590" y="1200" width="220" height="40" as="geometry"/></mxCell><mxCell id="p2-c22" value="Записать продажи в регистр «Продажи»" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="590" y="1260" width="220" height="40" as="geometry"/></mxCell><mxCell id="p2-c23" value="Запретить изменение заказа, освободить стол" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="p2-1"><mxGeometry x="590" y="1320" width="220" height="40" as="geometry"/></mxCell><mxCell id="p2-c24" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="p2-1"><mxGeometry x="685" y="1385" width="30" height="30" as="geometry"/></mxCell><mxCell id="p2-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="p2-1" source="p2-c4" target="p2-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="p2-1" source="p2-c5" target="p2-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="p2-1" source="p2-c6" target="p2-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="p2-1" source="p2-c8" target="p2-c9"><mxGeometry 